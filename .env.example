DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-for-local-development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
